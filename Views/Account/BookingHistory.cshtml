@model IEnumerable<Datxe>

@{
    ViewData["Title"] = "Lịch sử đặt xe";
}

<div class="container py-4">
    <h1 class="mb-4"><i class="fas fa-history"></i> Lịch Sử Đặt Xe</h1>

    @if (Model != null && Model.Any())
    {
        <div class="row">
            @foreach (var booking in Model)
            {
                <div class="col-lg-6 mb-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <strong>#DX@booking.Id.ToString("D6")</strong>
                            @if (booking.Trangthai == "Pending")
                            {
                                <span class="badge bg-warning">Chờ xác nhận</span>
                            }
                            else if (booking.Trangthai == "Confirmed")
                            {
                                <span class="badge bg-success">Đã xác nhận</span>
                            }
                            else if (booking.Trangthai == "Completed")
                            {
                                <span class="badge bg-info">Hoàn thành</span>
                            }
                            else if (booking.Trangthai == "Cancelled")
                            {
                                <span class="badge bg-danger">Đã hủy</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@booking.Trangthai</span>
                            }
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-4">
                                    @if (!string.IsNullOrEmpty(booking.Xe.Hinhanh))
                                    {
                                        <img src="@booking.Xe.Hinhanh" class="img-fluid rounded" alt="@booking.Xe.Tenxe">
                                    }
                                    else
                                    {
                                        <div class="bg-secondary rounded d-flex align-items-center justify-content-center" style="height: 80px;">
                                            <i class="fas fa-car fa-2x text-white"></i>
                                        </div>
                                    }
                                </div>
                                <div class="col-8">
                                    <h6>@booking.Xe.Tenxe</h6>
                                    <p class="text-muted small mb-1">@booking.Xe.Hangxe - @booking.Xe.Loaixe</p>
                                    <p class="text-muted small mb-0">Biển số: @booking.Xe.Biensoxe</p>
                                </div>
                            </div>
                            
                            <hr>
                            
                            <div class="row small">
                                <div class="col-6 mb-2">
                                    <i class="fas fa-calendar text-primary"></i> Ngày đặt:
                                    <div><strong>@booking.Ngaydat.ToString("dd/MM/yyyy")</strong></div>
                                </div>
                                <div class="col-6 mb-2">
                                    <i class="fas fa-clock text-primary"></i> Số ngày:
                                    <div><strong>@booking.Songaythue ngày</strong></div>
                                </div>
                                <div class="col-6 mb-2">
                                    <i class="fas fa-calendar-check text-primary"></i> Từ:
                                    <div><strong>@booking.Ngaybatdau.ToString("dd/MM HH:mm")</strong></div>
                                </div>
                                <div class="col-6 mb-2">
                                    <i class="fas fa-calendar-times text-primary"></i> Đến:
                                    <div><strong>@booking.Ngayketthuc.ToString("dd/MM HH:mm")</strong></div>
                                </div>
                            </div>

                            <hr>

                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="text-muted">Tổng tiền:</span>
                                    <div class="h5 text-primary mb-0">@booking.Tongtien.ToString("N0") đ</div>
                                </div>
                                <a href="@Url.Action("Details", "DatXe", new { id = booking.Id })" class="btn btn-outline-primary btn-sm">
                                    <i class="fas fa-eye"></i> Chi tiết
                                </a>
                            </div>

                            @if (booking.Thanhtoans != null && booking.Thanhtoans.Any())
                            {
                                <div class="mt-2">
                                    <small class="text-muted">
                                        <i class="fas fa-credit-card"></i> Thanh toán: 
                                        @foreach (var payment in booking.Thanhtoans)
                                        {
                                            <span class="badge bg-@(payment.Trangthai == "Completed" ? "success" : "warning")">
                                                @payment.Phuongthucthanhtoan
                                            </span>
                                        }
                                    </small>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <i class="fas fa-inbox fa-4x text-muted mb-3"></i>
                <h4>Chưa có đơn đặt xe nào</h4>
                <p class="text-muted">Bắt đầu tìm kiếm và đặt xe ngay hôm nay!</p>
                <a href="@Url.Action("Index", "Xe")" class="btn btn-primary">
                    <i class="fas fa-car"></i> Tìm xe ngay
                </a>
            </div>
        </div>
    }
</div>
