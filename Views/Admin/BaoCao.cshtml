@{
    ViewData["Title"] = "Báo cáo thống kê";
}

<div class="container-fluid py-4">
    <h2 class="mb-4"><i class="fas fa-chart-bar text-primary"></i> Báo cáo & Thống kê</h2>

    <!-- Revenue Comparison -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card shadow h-100">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="fas fa-dollar-sign"></i> Doanh thu tháng này</h5>
                </div>
                <div class="card-body">
                    <h2 class="text-success">@ViewBag.RevenueThisMonth.ToString("N0") đ</h2>
                    <p class="mb-2">
                        <strong>Số đơn:</strong> @ViewBag.BookingsThisMonth đơn
                    </p>
                    <hr>
                    <small class="text-muted">
                        So với tháng trước: 
                        @{
                            var change = ViewBag.RevenueThisMonth - ViewBag.RevenueLastMonth;
                            var percent = ViewBag.RevenueLastMonth > 0 ? (change / ViewBag.RevenueLastMonth * 100) : 0;
                        }
                        @if (change > 0)
                        {
                            <span class="text-success">
                                <i class="fas fa-arrow-up"></i> +@change.ToString("N0") đ (+@percent.ToString("N1")%)
                            </span>
                        }
                        else if (change < 0)
                        {
                            <span class="text-danger">
                                <i class="fas fa-arrow-down"></i> @change.ToString("N0") đ (@percent.ToString("N1")%)
                            </span>
                        }
                        else
                        {
                            <span class="text-muted">Không đổi</span>
                        }
                    </small>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow h-100">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="fas fa-chart-line"></i> Doanh thu tháng trước</h5>
                </div>
                <div class="card-body">
                    <h2 class="text-info">@ViewBag.RevenueLastMonth.ToString("N0") đ</h2>
                    <p class="mb-2">
                        <strong>Số đơn:</strong> @ViewBag.BookingsLastMonth đơn
                    </p>
                    <hr>
                    <small class="text-muted">
                        Trung bình/đơn: 
                        @if (ViewBag.BookingsLastMonth > 0)
                        {
                            @((ViewBag.RevenueLastMonth / ViewBag.BookingsLastMonth).ToString("N0")) <text>đ</text>
                        }
                        else
                        {
                            <span>0 đ</span>
                        }
                    </small>
                </div>
            </div>
        </div>
    </div>

    <!-- Top Cars -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0"><i class="fas fa-trophy"></i> Top 5 xe được thuê nhiều nhất</h5>
                </div>
                <div class="card-body">
                    @if (ViewBag.TopCars != null && ((IEnumerable<dynamic>)ViewBag.TopCars).Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Hạng</th>
                                        <th>Tên xe</th>
                                        <th>Hãng</th>
                                        <th>Loại</th>
                                        <th>Biển số</th>
                                        <th>Số lần thuê</th>
                                        <th>Giá/ngày</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        int rank = 1;
                                        foreach (var item in (IEnumerable<dynamic>)ViewBag.TopCars)
                                        {
                                            var xe = item.Xe;
                                            var count = item.Count;
                                            <tr>
                                                <td>
                                                    @if (rank == 1)
                                                    {
                                                        <span class="badge bg-warning text-dark">
                                                            <i class="fas fa-crown"></i> #@rank
                                                        </span>
                                                    }
                                                    else if (rank == 2)
                                                    {
                                                        <span class="badge bg-secondary">
                                                            <i class="fas fa-medal"></i> #@rank
                                                        </span>
                                                    }
                                                    else if (rank == 3)
                                                    {
                                                        <span class="badge bg-danger">
                                                            <i class="fas fa-medal"></i> #@rank
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-light text-dark">#@rank</span>
                                                    }
                                                </td>
                                                <td><strong>@xe.Tenxe</strong></td>
                                                <td>@xe.Hangxe</td>
                                                <td><span class="badge bg-info">@xe.Loaixe</span></td>
                                                <td>@xe.Biensoxe</td>
                                                <td>
                                                    <span class="badge bg-success">@count lần</span>
                                                </td>
                                                <td>@xe.Giathuetheongay.ToString("N0") đ</td>
                                            </tr>
                                            rank++;
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i> Chưa có dữ liệu thống kê
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Placeholder -->
    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-chart-pie"></i> Phân bố loại xe</h5>
                </div>
                <div class="card-body">
                    <canvas id="carTypeChart" height="200"></canvas>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="fas fa-chart-line"></i> Doanh thu 6 tháng gần nhất</h5>
                </div>
                <div class="card-body">
                    <canvas id="revenueChart" height="200"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <a href="@Url.Action("Index")" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Quay lại Dashboard
        </a>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>
    <script>
        // Car Type Chart
        const carTypeCtx = document.getElementById('carTypeChart').getContext('2d');
        const carTypeChart = new Chart(carTypeCtx, {
            type: 'pie',
            data: {
                labels: ['Sedan', 'SUV', 'MPV', 'Hatchback'],
                datasets: [{
                    data: [30, 40, 20, 10],
                    backgroundColor: [
                        'rgba(54, 162, 235, 0.8)',
                        'rgba(255, 99, 132, 0.8)',
                        'rgba(255, 206, 86, 0.8)',
                        'rgba(75, 192, 192, 0.8)'
                    ]
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true
            }
        });

        // Revenue Chart
        const revenueCtx = document.getElementById('revenueChart').getContext('2d');
        const revenueChart = new Chart(revenueCtx, {
            type: 'line',
            data: {
                labels: ['Tháng 8', 'Tháng 9', 'Tháng 10', 'Tháng 11', 'Tháng 12', 'Tháng 1'],
                datasets: [{
                    label: 'Doanh thu (triệu đồng)',
                    data: [50, 65, 80, 75, 90, 100],
                    borderColor: 'rgba(75, 192, 192, 1)',
                    backgroundColor: 'rgba(75, 192, 192, 0.2)',
                    tension: 0.4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                scales: {
                    y: {
                        beginAtZero: true
                    }
                }
            }
        });
    </script>
}
