@model duanminiveprogresql.Models.Xe

@{
    ViewData["Title"] = "Thêm xe mới";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0"><i class="fas fa-plus-circle"></i> Thêm xe mới</h4>
                </div>
                <div class="card-body">
                    <form method="post" asp-action="CreateXe">
                        @Html.AntiForgeryToken()

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label"><i class="fas fa-car"></i> Tên xe <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="Tenxe" required placeholder="VD: Toyota Fortuner 2024">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label"><i class="fas fa-industry"></i> Hãng xe <span class="text-danger">*</span></label>
                                <select class="form-select" name="Hangxe" required>
                                    <option value="">-- Chọn hãng --</option>
                                    <option value="Toyota">Toyota</option>
                                    <option value="Honda">Honda</option>
                                    <option value="Hyundai">Hyundai</option>
                                    <option value="Mazda">Mazda</option>
                                    <option value="Ford">Ford</option>
                                    <option value="Kia">Kia</option>
                                    <option value="Mercedes">Mercedes</option>
                                    <option value="BMW">BMW</option>
                                    <option value="Vinfast">Vinfast</option>
                                </select>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label"><i class="fas fa-layer-group"></i> Loại xe <span class="text-danger">*</span></label>
                                <select class="form-select" name="Loaixe" required>
                                    <option value="">-- Chọn loại --</option>
                                    <option value="Sedan">Sedan (4-5 chỗ)</option>
                                    <option value="SUV">SUV (7 chỗ)</option>
                                    <option value="MPV">MPV (7 chỗ)</option>
                                    <option value="Hatchback">Hatchback (4-5 chỗ)</option>
                                    <option value="Pickup">Pickup</option>
                                </select>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label"><i class="fas fa-users"></i> Số chỗ ngồi <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" name="Sochongoi" required min="2" max="16" value="5">
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label"><i class="fas fa-calendar"></i> Năm sản xuất <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" name="Namsanxuat" required min="2000" max="2025" value="2024">
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label"><i class="fas fa-palette"></i> Màu xe <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="Mauxe" required placeholder="VD: Trắng ngọc trai">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label"><i class="fas fa-id-card"></i> Biển số xe <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="Biensoxe" required placeholder="VD: 30A-12345" pattern="[0-9]{2}[A-Z]{1}-[0-9]{5}">
                                <small class="text-muted">Định dạng: 30A-12345</small>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label"><i class="fas fa-dollar-sign"></i> Giá thuê/ngày (VNĐ) <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" name="Giathuetheongay" required min="100000" step="50000" placeholder="500000">
                                <small class="text-muted">Tối thiểu 100,000 VNĐ</small>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label"><i class="fas fa-image"></i> Hình ảnh URL</label>
                                <input type="url" class="form-control" name="Hinhanh" placeholder="https://example.com/image.jpg">
                                <small class="text-muted">Để trống nếu chưa có</small>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label"><i class="fas fa-align-left"></i> Mô tả</label>
                            <textarea class="form-control" name="Mota" rows="4" placeholder="Nhập mô tả chi tiết về xe..."></textarea>
                        </div>

                        <hr>

                        <div class="d-flex justify-content-between">
                            <a href="@Url.Action("Xe")" class="btn btn-secondary">
                                <i class="fas fa-times"></i> Hủy
                            </a>
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-save"></i> Lưu xe
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Preview image when URL is entered
        document.querySelector('input[name="Hinhanh"]').addEventListener('change', function(e) {
            const url = e.target.value;
            if (url) {
                const preview = document.createElement('img');
                preview.src = url;
                preview.style.maxWidth = '200px';
                preview.style.marginTop = '10px';
                preview.className = 'img-thumbnail';
                
                const existingPreview = e.target.parentElement.querySelector('img');
                if (existingPreview) {
                    existingPreview.remove();
                }
                
                e.target.parentElement.appendChild(preview);
            }
        });
    </script>
}
