@model duanminiveprogresql.Models.Xe

@{
    ViewData["Title"] = "Chỉnh sửa xe";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0"><i class="fas fa-edit"></i> Chỉnh sửa xe: @Model.Tenxe</h4>
                </div>
                <div class="card-body">
                    <form method="post" asp-action="EditXe">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="Id" value="@Model.Id" />
                        <input type="hidden" name="Ngaytao" value="@Model.Ngaytao" />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label"><i class="fas fa-car"></i> Tên xe <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="Tenxe" required value="@Model.Tenxe">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label"><i class="fas fa-industry"></i> Hãng xe <span class="text-danger">*</span></label>
                                <select class="form-select" name="Hangxe" required>
                                    <option value="Toyota" selected="@(Model.Hangxe == "Toyota")">Toyota</option>
                                    <option value="Honda" selected="@(Model.Hangxe == "Honda")">Honda</option>
                                    <option value="Hyundai" selected="@(Model.Hangxe == "Hyundai")">Hyundai</option>
                                    <option value="Mazda" selected="@(Model.Hangxe == "Mazda")">Mazda</option>
                                    <option value="Ford" selected="@(Model.Hangxe == "Ford")">Ford</option>
                                    <option value="Kia" selected="@(Model.Hangxe == "Kia")">Kia</option>
                                    <option value="Mercedes" selected="@(Model.Hangxe == "Mercedes")">Mercedes</option>
                                    <option value="BMW" selected="@(Model.Hangxe == "BMW")">BMW</option>
                                    <option value="Vinfast" selected="@(Model.Hangxe == "Vinfast")">Vinfast</option>
                                </select>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label"><i class="fas fa-layer-group"></i> Loại xe <span class="text-danger">*</span></label>
                                <select class="form-select" name="Loaixe" required>
                                    <option value="Sedan" selected="@(Model.Loaixe == "Sedan")">Sedan (4-5 chỗ)</option>
                                    <option value="SUV" selected="@(Model.Loaixe == "SUV")">SUV (7 chỗ)</option>
                                    <option value="MPV" selected="@(Model.Loaixe == "MPV")">MPV (7 chỗ)</option>
                                    <option value="Hatchback" selected="@(Model.Loaixe == "Hatchback")">Hatchback (4-5 chỗ)</option>
                                    <option value="Pickup" selected="@(Model.Loaixe == "Pickup")">Pickup</option>
                                </select>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label"><i class="fas fa-users"></i> Số chỗ ngồi <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" name="Sochongoi" required min="2" max="16" value="@Model.Sochongoi">
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label"><i class="fas fa-calendar"></i> Năm sản xuất <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" name="Namsanxuat" required min="2000" max="2025" value="@Model.Namsanxuat">
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label"><i class="fas fa-palette"></i> Màu xe <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="Mauxe" required value="@Model.Mauxe">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label"><i class="fas fa-id-card"></i> Biển số xe <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="Biensoxe" required value="@Model.Biensoxe">
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label"><i class="fas fa-dollar-sign"></i> Giá thuê/ngày (VNĐ) <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" name="Giathuetheongay" required min="100000" step="50000" value="@Model.Giathuetheongay">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label"><i class="fas fa-toggle-on"></i> Trạng thái <span class="text-danger">*</span></label>
                                <select class="form-select" name="Trangthai" required>
                                    <option value="Available" selected="@(Model.Trangthai == "Available")">Khả dụng</option>
                                    <option value="Rented" selected="@(Model.Trangthai == "Rented")">Đang cho thuê</option>
                                    <option value="Maintenance" selected="@(Model.Trangthai == "Maintenance")">Bảo trì</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label"><i class="fas fa-image"></i> Hình ảnh URL</label>
                            <input type="url" class="form-control" name="Hinhanh" value="@Model.Hinhanh">
                            @if (!string.IsNullOrEmpty(Model.Hinhanh))
                            {
                                <img src="@Model.Hinhanh" alt="@Model.Tenxe" class="img-thumbnail mt-2" style="max-width: 200px;">
                            }
                        </div>

                        <div class="mb-3">
                            <label class="form-label"><i class="fas fa-align-left"></i> Mô tả</label>
                            <textarea class="form-control" name="Mota" rows="4">@Model.Mota</textarea>
                        </div>

                        <hr>

                        <div class="d-flex justify-content-between">
                            <a href="@Url.Action("Xe")" class="btn btn-secondary">
                                <i class="fas fa-times"></i> Hủy
                            </a>
                            <button type="submit" class="btn btn-warning text-dark">
                                <i class="fas fa-save"></i> Cập nhật
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
