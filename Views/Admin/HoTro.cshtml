@model IEnumerable<Domain.Entities.Hotrokhachhang>

@{
    ViewData["Title"] = "Hỗ trợ khách hàng";
}

<div class="container-fluid py-4">
    <h2 class="mb-4"><i class="fas fa-headset text-primary"></i> Hỗ trợ khách hàng</h2>

    <!-- Filter Tabs -->
    <ul class="nav nav-pills mb-3">
        <li class="nav-item">
            <a class="nav-link @(ViewBag.CurrentStatus == "All" ? "active" : "")" 
               href="@Url.Action("HoTro", new { status = "All" })">
                <i class="fas fa-list"></i> Tất cả
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(ViewBag.CurrentStatus == "Open" ? "active" : "")" 
               href="@Url.Action("HoTro", new { status = "Open" })">
                <i class="fas fa-folder-open"></i> Mới
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(ViewBag.CurrentStatus == "In Progress" ? "active" : "")" 
               href="@Url.Action("HoTro", new { status = "In Progress" })">
                <i class="fas fa-spinner"></i> Đang xử lý
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(ViewBag.CurrentStatus == "Resolved" ? "active" : "")" 
               href="@Url.Action("HoTro", new { status = "Resolved" })">
                <i class="fas fa-check"></i> Đã giải quyết
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(ViewBag.CurrentStatus == "Closed" ? "active" : "")" 
               href="@Url.Action("HoTro", new { status = "Closed" })">
                <i class="fas fa-lock"></i> Đã đóng
            </a>
        </li>
    </ul>

    <div class="card shadow">
        <div class="card-header bg-danger text-white">
            <h5 class="mb-0">Danh sách yêu cầu hỗ trợ</h5>
        </div>
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="accordion" id="supportAccordion">
                    @{
                        int index = 0;
                        foreach (var ticket in Model)
                        {
                            index++;
                            var badgeClass = ticket.Trangthai switch
                            {
                                "Open" => "bg-warning text-dark",
                                "In Progress" => "bg-info",
                                "Resolved" => "bg-success",
                                "Closed" => "bg-secondary",
                                _ => "bg-light text-dark"
                            };
                            
                            var priorityBadge = ticket.Mucdouutien switch
                            {
                                "High" => "bg-danger",
                                "Normal" => "bg-primary",
                                "Low" => "bg-secondary",
                                _ => "bg-light text-dark"
                            };

                            <div class="accordion-item mb-2">
                                <h2 class="accordion-header" id="heading@index">
                                    <button class="accordion-button collapsed" type="button" 
                                            data-bs-toggle="collapse" data-bs-target="#collapse@index">
                                        <div class="d-flex w-100 justify-content-between align-items-center pe-3">
                                            <div>
                                                <span class="badge @priorityBadge me-2">@ticket.Mucdouutien</span>
                                                <strong>#@ticket.Id - @ticket.Tieude</strong>
                                            </div>
                                            <div>
                                                <span class="badge @badgeClass me-2">@ticket.Trangthai</span>
                                                <small class="text-muted">@ticket.Ngaytao.ToString("dd/MM/yyyy")</small>
                                            </div>
                                        </div>
                                    </button>
                                </h2>
                                <div id="collapse@index" class="accordion-collapse collapse" 
                                     data-bs-parent="#supportAccordion">
                                    <div class="accordion-body">
                                        <div class="row">
                                            <div class="col-md-8">
                                                <h6><i class="fas fa-user"></i> Khách hàng</h6>
                                                <p>
                                                    <strong>@ticket.Khachhang.Nguoidung.Hoten</strong><br>
                                                    <small class="text-muted">
                                                        <i class="fas fa-envelope"></i> @ticket.Khachhang.Nguoidung.Email<br>
                                                        <i class="fas fa-phone"></i> @ticket.Khachhang.Nguoidung.Sodienthoai
                                                    </small>
                                                </p>

                                                <h6><i class="fas fa-align-left"></i> Nội dung</h6>
                                                <div class="card bg-light">
                                                    <div class="card-body">
                                                        <p class="mb-0">@ticket.Noidung</p>
                                                    </div>
                                                </div>

                                                @if (!string.IsNullOrEmpty(ticket.Traloi))
                                                {
                                                    <h6 class="mt-3"><i class="fas fa-reply"></i> Trả lời</h6>
                                                    <div class="card bg-success text-white">
                                                        <div class="card-body">
                                                            <p class="mb-0">@ticket.Traloi</p>
                                                            @if (ticket.Ngaygiaiquyet.HasValue)
                                                            {
                                                                <small>Giải quyết lúc: @ticket.Ngaygiaiquyet.Value.ToString("dd/MM/yyyy HH:mm")</small>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                                else if (ticket.Trangthai != "Resolved" && ticket.Trangthai != "Closed")
                                                {
                                                    <h6 class="mt-3"><i class="fas fa-reply"></i> Trả lời yêu cầu</h6>
                                                    <form method="post" asp-action="ReplySupport">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@ticket.Id" />
                                                        <div class="mb-3">
                                                            <textarea class="form-control" name="reply" rows="4" 
                                                                      placeholder="Nhập nội dung trả lời..." required></textarea>
                                                        </div>
                                                        <button type="submit" class="btn btn-success">
                                                            <i class="fas fa-paper-plane"></i> Gửi trả lời
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                            <div class="col-md-4">
                                                <h6><i class="fas fa-info-circle"></i> Thông tin</h6>
                                                <table class="table table-sm table-bordered">
                                                    <tr>
                                                        <th>Loại:</th>
                                                        <td>@ticket.Loaiyeucau</td>
                                                    </tr>
                                                    <tr>
                                                        <th>Ưu tiên:</th>
                                                        <td><span class="badge @priorityBadge">@ticket.Mucdouutien</span></td>
                                                    </tr>
                                                    <tr>
                                                        <th>Trạng thái:</th>
                                                        <td><span class="badge @badgeClass">@ticket.Trangthai</span></td>
                                                    </tr>
                                                    <tr>
                                                        <th>Tạo lúc:</th>
                                                        <td>@ticket.Ngaytao.ToString("dd/MM/yyyy HH:mm")</td>
                                                    </tr>
                                                    @if (ticket.Ngaycapnhat.HasValue)
                                                    {
                                                        <tr>
                                                            <th>Cập nhật:</th>
                                                            <td>@ticket.Ngaycapnhat.Value.ToString("dd/MM/yyyy HH:mm")</td>
                                                        </tr>
                                                    }
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i> Không có yêu cầu hỗ trợ nào
                    @if (ViewBag.CurrentStatus != "All")
                    {
                        <text> v?i tr?ng thái <strong>@ViewBag.CurrentStatus</strong></text>
                    }
                </div>
            }
        </div>
    </div>

    <div class="mt-3">
        <a href="@Url.Action("Index")" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Quay l?i Dashboard
        </a>
    </div>
</div>
