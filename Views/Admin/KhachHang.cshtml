@model IEnumerable<duanminiveprogresql.Models.Khachhang>

@{
    ViewData["Title"] = "Quản lý khách hàng";
}

<div class="container-fluid py-4">
    <h2 class="mb-4"><i class="fas fa-users text-primary"></i> Quản lý khách hàng</h2>

    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Danh sách khách hàng</h5>
        </div>
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Thông tin cá nhân</th>
                                <th>Liên hệ</th>
                                <th>Giấy tờ</th>
                                <th>Ngày sinh</th>
                                <th>Ngày đăng ký</th>
                                <th>Xác thực</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var customer in Model)
                            {
                                <tr>
                                    <td><strong>#@customer.Id</strong></td>
                                    <td>
                                        <strong>@customer.Nguoidung.Hoten</strong><br>
                                        <small class="text-muted">
                                            <i class="fas fa-@(customer.Gioitinh == "Nam" ? "mars text-primary" : "venus text-danger")"></i> 
                                            @customer.Gioitinh
                                        </small>
                                    </td>
                                    <td>
                                        <i class="fas fa-envelope"></i> @customer.Nguoidung.Email<br>
                                        <i class="fas fa-phone"></i> @(customer.Nguoidung.Sodienthoai ?? "Chưa có")
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(customer.Cmnd))
                                        {
                                            <small>
                                                <i class="fas fa-id-card"></i> CMND: @customer.Cmnd<br>
                                                <i class="fas fa-id-badge"></i> Bằng lái: @(customer.Banglai ?? "Chưa có")
                                            </small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Chưa cập nhật</span>
                                        }
                                    </td>
                                    <td>
                                        @if (customer.Ngaysinh.HasValue)
                                        {
                                            @customer.Ngaysinh.Value.ToString("dd/MM/yyyy")
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        <small>@customer.Ngaydangky.ToString("dd/MM/yyyy")</small>
                                    </td>
                                    <td>
                                        @if (customer.Daxacthuc)
                                        {
                                            <span class="badge bg-success">
                                                <i class="fas fa-check-circle"></i> Đã xác thực
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                <i class="fas fa-clock"></i> Chưa xác thực
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (!customer.Daxacthuc)
                                        {
                                            <a href="@Url.Action("VerifyCustomer", new { id = customer.Id })" 
                                               class="btn btn-sm btn-success"
                                               onclick="return confirm('Xác thực khách hàng @customer.Nguoidung.Hoten?')"
                                               title="Xác thực">
                                                <i class="fas fa-check"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i> Chưa có khách hàng nào đăng ký
                </div>
            }
        </div>
    </div>

    <div class="mt-3">
        <a href="@Url.Action("Index")" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Quay lại Dashboard
        </a>
    </div>
</div>
