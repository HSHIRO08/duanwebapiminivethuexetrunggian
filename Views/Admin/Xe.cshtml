@model IEnumerable<Domain.Entities.Xe>

@{
    ViewData["Title"] = "Quản lý xe";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-car text-primary"></i> Quản lý xe</h2>
        <a href="@Url.Action("CreateXe")" class="btn btn-success">
            <i class="fas fa-plus"></i> Thêm xe mới
        </a>
    </div>

    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Danh sách xe</h5>
        </div>
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Hình ảnh</th>
                                <th>Tên xe</th>
                                <th>Hãng</th>
                                <th>Loại</th>
                                <th>Biển số</th>
                                <th>Số chỗ</th>
                                <th>Giá/ngày</th>
                                <th>Trạng thái</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var xe in Model)
                            {
                                <tr>
                                    <td>@xe.Id</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(xe.Hinhanh))
                                        {
                                            <img src="@xe.Hinhanh" alt="@xe.Tenxe" style="width: 60px; height: 40px; object-fit: cover;" class="rounded">
                                        }
                                        else
                                        {
                                            <div style="width: 60px; height: 40px;" class="bg-secondary rounded d-flex align-items-center justify-content-center">
                                                <i class="fas fa-car text-white"></i>
                                            </div>
                                        }
                                    </td>
                                    <td><strong>@xe.Tenxe</strong></td>
                                    <td>@xe.Hangxe</td>
                                    <td><span class="badge bg-info">@xe.Loaixe</span></td>
                                    <td>@xe.Biensoxe</td>
                                    <td>@xe.Sochongoi ch?</td>
                                    <td><strong class="text-success">@xe.Giathuetheongay.ToString("N0") d</strong></td>
                                    <td>
                                        @if (xe.Trangthai == "Available")
                                        {
                                            <span class="badge bg-success">Kh? d?ng</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Ðang thuê</span>
                                        }
                                    </td>
                                    <td>
                                        <a href="@Url.Action("EditXe", new { id = xe.Id })" class="btn btn-sm btn-primary" title="S?a">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a href="@Url.Action("DeleteXe", new { id = xe.Id })" 
                                           class="btn btn-sm btn-danger"
                                           onclick="return confirm('Bạn có chắc muốn xóa xe @xe.Tenxe?')"
                                           title="Xóa">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i> Chua có xe nào trong hệ thống
                </div>
            }
        </div>
    </div>

    <div class="mt-3">
        <a href="@Url.Action("Index")" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Quay lại Dashboard
        </a>
    </div>
</div>
