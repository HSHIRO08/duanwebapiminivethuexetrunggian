@model Datxe

@{
    ViewData["Title"] = "Chi tiết đặt xe";
}

<div class="container py-4">
    <h1 class="mb-4">Chi Tiết Đơn Đặt Xe</h1>

    <div class="row">
        <!-- Booking Details -->
        <div class="col-lg-8 mb-4">
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-file-alt"></i> Thông tin đặt xe</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>Mã đặt xe:</strong>
                            <p>#DX@Model.Id.ToString("D6")</p>
                        </div>
                        <div class="col-md-6">
                            <strong>Trạng thái:</strong>
                            <p>
                                @if (Model.Trangthai == "Pending")
                                {
                                    <span class="badge bg-warning">Chờ xác nhận</span>
                                }
                                else if (Model.Trangthai == "Confirmed")
                                {
                                    <span class="badge bg-success">Đã xác nhận</span>
                                }
                                else if (Model.Trangthai == "Completed")
                                {
                                    <span class="badge bg-info">Hoàn thành</span>
                                }
                                else if (Model.Trangthai == "Cancelled")
                                {
                                    <span class="badge bg-danger">Đã hủy</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@Model.Trangthai</span>
                                }
                            </p>
                        </div>
                    </div>

                    <hr>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <strong><i class="fas fa-calendar-alt"></i> Ngày đặt:</strong>
                            <p>@Model.Ngaydat.ToString("dd/MM/yyyy HH:mm")</p>
                        </div>
                        <div class="col-md-6 mb-3">
                            <strong><i class="fas fa-calendar-check"></i> Ngày bắt đầu:</strong>
                            <p>@Model.Ngaybatdau.ToString("dd/MM/yyyy HH:mm")</p>
                        </div>
                        <div class="col-md-6 mb-3">
                            <strong><i class="fas fa-calendar-times"></i> Ngày kết thúc:</strong>
                            <p>@Model.Ngayketthuc.ToString("dd/MM/yyyy HH:mm")</p>
                        </div>
                        <div class="col-md-6 mb-3">
                            <strong><i class="fas fa-clock"></i> Số ngày thuê:</strong>
                            <p>@Model.Songaythue ngày</p>
                        </div>
                    </div>

                    <hr>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <strong><i class="fas fa-map-marker-alt"></i> Địa điểm nhận:</strong>
                            <p>@Model.Diadiemnhan</p>
                        </div>
                        <div class="col-md-6 mb-3">
                            <strong><i class="fas fa-map-marker-alt"></i> Địa điểm trả:</strong>
                            <p>@Model.Diadiemtra</p>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Ghichu))
                    {
                        <hr>
                        <strong><i class="fas fa-sticky-note"></i> Ghi chú:</strong>
                        <p>@Model.Ghichu</p>
                    }
                </div>
            </div>

            <!-- Car Info -->
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-car"></i> Thông tin xe</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4">
                            @if (!string.IsNullOrEmpty(Model.Xe.Hinhanh))
                            {
                                <img src="@Model.Xe.Hinhanh" class="img-fluid rounded" alt="@Model.Xe.Tenxe">
                            }
                            else
                            {
                                <div class="bg-secondary rounded d-flex align-items-center justify-content-center" style="height: 150px;">
                                    <i class="fas fa-car fa-3x text-white"></i>
                                </div>
                            }
                        </div>
                        <div class="col-md-8">
                            <h5>@Model.Xe.Tenxe</h5>
                            <p class="text-muted">@Model.Xe.Hangxe - @Model.Xe.Loaixe</p>
                            <ul class="list-unstyled">
                                <li><i class="fas fa-users"></i> @Model.Xe.Sochongoi chỗ</li>
                                <li><i class="fas fa-palette"></i> Màu @Model.Xe.Mauxe</li>
                                <li><i class="fas fa-car"></i> Biển số: @Model.Xe.Biensoxe</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Price Summary & Actions -->
        <div class="col-lg-4">
            <div class="card mb-4">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="fas fa-money-bill"></i> Chi tiết thanh toán</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span>Giá thuê/ngày:</span>
                        <strong>@Model.Giatheongay.ToString("N0") đ</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Số ngày:</span>
                        <strong>@Model.Songaythue</strong>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between">
                        <strong>Tổng tiền:</strong>
                        <strong class="text-primary h5">@Model.Tongtien.ToString("N0") đ</strong>
                    </div>
                </div>
            </div>

            <!-- Payment Status -->
            @if (Model.Thanhtoans != null && Model.Thanhtoans.Any())
            {
                <div class="card mb-4">
                    <div class="card-header">
                        <h6 class="mb-0"><i class="fas fa-credit-card"></i> Thanh toán</h6>
                    </div>
                    <div class="card-body">
                        @foreach (var payment in Model.Thanhtoans)
                        {
                            <div class="mb-2">
                                <small class="text-muted">@payment.Ngaythanhtoan.ToString("dd/MM/yyyy HH:mm")</small>
                                <div class="d-flex justify-content-between">
                                    <span>@payment.Phuongthucthanhtoan</span>
                                    <strong>@payment.Sotien.ToString("N0") đ</strong>
                                </div>
                                <span class="badge bg-@(payment.Trangthai == "Completed" ? "success" : "warning")">
                                    @payment.Trangthai
                                </span>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Actions -->
            <div class="card">
                <div class="card-body">
                    @if (Model.Trangthai == "Pending" || Model.Trangthai == "Confirmed")
                    {
                        <button type="button" class="btn btn-danger w-100 mb-2" onclick="cancelBooking(@Model.Id)">
                            <i class="fas fa-times-circle"></i> Hủy đơn
                        </button>
                    }
                    
                    <a href="@Url.Action("BookingHistory", "Account")" class="btn btn-outline-primary w-100">
                        <i class="fas fa-list"></i> Xem tất cả đơn đặt
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function cancelBooking(id) {
            if (confirm('Bạn có chắc chắn muốn hủy đơn đặt xe này?')) {
                $.ajax({
                    url: '@Url.Action("Cancel", "DatXe")',
                    type: 'POST',
                    data: { id: id },
                    success: function(response) {
                        if (response.success) {
                            alert(response.message);
                            location.reload();
                        } else {
                            alert(response.message);
                        }
                    },
                    error: function() {
                        alert('Có lỗi xảy ra, vui lòng thử lại!');
                    }
                });
            }
        }
    </script>
}
