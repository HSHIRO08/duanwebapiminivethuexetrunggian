@{
    ViewData["Title"] = "Liên hệ";
}

<div class="container py-5">
    <div class="row">
        <div class="col-12 text-center mb-5">
            <h1 class="display-4 fw-bold">
                <i class="fas fa-phone text-primary"></i> Liên Hệ Với Chúng Tôi
            </h1>
            <p class="lead text-muted">Chúng tôi luôn sẵn sàng hỗ trợ bạn 24/7</p>
        </div>
    </div>

    <div class="row">
        <!-- Contact Form -->
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-envelope"></i> Gửi Tin Nhắn</h5>
                </div>
                <div class="card-body">
                    <form method="post" asp-action="Contact">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label">
                                <i class="fas fa-user"></i> Họ và tên <span class="text-danger">*</span>
                            </label>
                            <input type="text" class="form-control" name="name" required placeholder="Nguyễn Văn A">
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                <i class="fas fa-envelope"></i> Email <span class="text-danger">*</span>
                            </label>
                            <input type="email" class="form-control" name="email" required placeholder="email@example.com">
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                <i class="fas fa-phone"></i> Số điện thoại
                            </label>
                            <input type="tel" class="form-control" name="phone" placeholder="0123456789">
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                <i class="fas fa-comment"></i> Nội dung <span class="text-danger">*</span>
                            </label>
                            <textarea class="form-control" name="message" rows="5" required 
                                      placeholder="Nhập nội dung câu hỏi hoặc yêu cầu của bạn..."></textarea>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">
                            <i class="fas fa-paper-plane"></i> Gửi tin nhắn
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Contact Info -->
        <div class="col-md-6 mb-4">
            <!-- Contact Details -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="fas fa-info-circle"></i> Thông Tin Liên Hệ</h5>
                </div>
                <div class="card-body">
                    <div class="mb-4">
                        <h6 class="text-primary">
                            <i class="fas fa-map-marker-alt"></i> Địa chỉ
                        </h6>
                        <p class="mb-0">Hà Nội</p>
                    </div>

                    <div class="mb-4">
                        <h6 class="text-primary">
                            <i class="fas fa-phone"></i> Hotline
                        </h6>
                        <p class="mb-0">
                            <a href="tel:0123456789" class="text-decoration-none">0981231205</a> (24/7)
                        </p>
                    </div>

                    <div class="mb-4">
                        <h6 class="text-primary">
                            <i class="fas fa-envelope"></i> Email
                        </h6>
                        <p class="mb-0">
                            <a href="mailto:mainhathoangevil@gmail.com" class="text-decoration-none">mainhathoangevil@gmail.com</a>
                        </p>
                    </div>

                    <div class="mb-4">
                        <h6 class="text-primary">
                            <i class="fas fa-clock"></i> Giờ làm việc
                        </h6>
                        <p class="mb-0">
                            Thứ 2 - Thứ 7: 8:00 - 20:00<br>
                            Chủ nhật: 9:00 - 18:00
                        </p>
                    </div>

                    <div>
                        <h6 class="text-primary mb-3">
                            <i class="fas fa-share-alt"></i> Mạng xã hội
                        </h6>
                        <a href="#" class="btn btn-outline-primary me-2 mb-2">
                            <i class="fab fa-facebook-f" href="https://www.facebook.com/hshiro08"></i> Facebook
                        </a>
                        <a href="#" class="btn btn-outline-info me-2 mb-2">
                            <i class="fab fa-twitter"></i> Twitter
                        </a>
                        <a href="#" class="btn btn-outline-danger mb-2">
                            <i class="fab fa-instagram"></i> Instagram
                        </a>
                    </div>
                </div>
            </div>

            <!-- FAQ Quick Links -->
            <div class="card shadow-sm">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0"><i class="fas fa-question-circle"></i> Câu Hỏi Thường Gặp</h5>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2">
                            <i class="fas fa-chevron-right text-primary"></i>
                            <a href="#" class="text-decoration-none">Điều kiện thuê xe?</a>
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-chevron-right text-primary"></i>
                            <a href="#" class="text-decoration-none">Chính sách hủy đơn?</a>
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-chevron-right text-primary"></i>
                            <a href="#" class="text-decoration-none">Bảo hiểm như thế nào?</a>
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-chevron-right text-primary"></i>
                            <a href="#" class="text-decoration-none">Thanh toán bằng gì?</a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- Map Section -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="fas fa-map"></i> Bản Đồ</h5>
                </div>
                <div class="card-body p-0">
                    <iframe 
                        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3724.0969104084283!2d105.81673631533285!3d21.028511793002644!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3135ab9bd9861ca1%3A0xe7887f7b72ca17a!2zSMOgIE7hu5lp!5e0!3m2!1svi!2s!4v1234567890"
                        width="100%" 
                        height="400" 
                        style="border:0;" 
                        allowfullscreen="" 
                        loading="lazy">
                    </iframe>
                </div>
            </div>
        </div>
    </div>
</div>
