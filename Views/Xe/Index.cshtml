@model IEnumerable<Xe>

@{
    ViewData["Title"] = "Danh sách xe";
}

<div class="container py-4">
    <h1 class="mb-4">Danh Sách Xe Cho Thuê</h1>

    <!-- Filter Section -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" asp-action="Index">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Tìm ki?m</label>
                        <input type="text" class="form-control" name="search" placeholder="Tên xe, hãng, bi?n s?..." value="@Context.Request.Query["search"]">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Lo?i xe</label>
                        <select class="form-select" name="loaixe">
                            <option value="">T?t c?</option>
                            @if (ViewBag.LoaiXeList != null)
                            {
                                @foreach (var loai in ViewBag.LoaiXeList)
                                {
                                    <option value="@loai" selected="@(Context.Request.Query["loaixe"] == loai)">@loai</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Hãng xe</label>
                        <select class="form-select" name="hangxe">
                            <option value="">T?t c?</option>
                            @if (ViewBag.HangXeList != null)
                            {
                                @foreach (var hang in ViewBag.HangXeList)
                                {
                                    <option value="@hang" selected="@(Context.Request.Query["hangxe"] == hang)">@hang</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Giá t?</label>
                        <input type="number" class="form-control" name="minPrice" placeholder="0" value="@Context.Request.Query["minPrice"]">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Giá ??n</label>
                        <input type="number" class="form-control" name="maxPrice" placeholder="10000000" value="@Context.Request.Query["maxPrice"]">
                    </div>
                    <div class="col-md-1 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Results -->
    <div class="row">
        @if (Model != null && Model.Any())
        {
            <div class="col-12 mb-3">
                <p class="text-muted">Tìm th?y @Model.Count() xe</p>
            </div>
            
            @foreach (var xe in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card car-card h-100 shadow-sm">
                        @if (!string.IsNullOrEmpty(xe.Hinhanh))
                        {
                            <img src="@xe.Hinhanh" class="card-img-top" alt="@xe.Tenxe" style="height: 220px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 220px;">
                                <i class="fas fa-car fa-4x text-white"></i>
                            </div>
                        }
                        <span class="badge bg-success position-absolute m-2">@xe.Trangthai</span>
                        <div class="card-body">
                            <h5 class="card-title">@xe.Tenxe</h5>
                            <p class="text-muted mb-2">
                                <i class="fas fa-tag"></i> @xe.Hangxe
                                <span class="badge bg-secondary ms-1">@xe.Loaixe</span>
                            </p>
                            <div class="mb-2">
                                <small class="text-muted">
                                    <i class="fas fa-users"></i> @xe.Sochongoi ch? |
                                    <i class="fas fa-calendar"></i> @xe.Namsanxuat |
                                    <i class="fas fa-palette"></i> @xe.Mauxe
                                </small>
                            </div>
                            @if (!string.IsNullOrEmpty(xe.Mota))
                            {
                                <p class="card-text small text-muted">
                                    @(xe.Mota.Length > 80 ? xe.Mota.Substring(0, 80) + "..." : xe.Mota)
                                </p>
                            }
                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <div>
                                    <span class="h5 text-primary mb-0">@xe.Giathuetheongay.ToString("N0") ?</span>
                                    <small class="text-muted d-block">/ngày</small>
                                </div>
                                <a href="@Url.Action("Details", "Xe", new { id = xe.Id })" class="btn btn-primary">
                                    <i class="fas fa-info-circle"></i> Chi ti?t
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-info text-center">
                    <i class="fas fa-info-circle fa-3x mb-3"></i>
                    <h4>Không tìm th?y xe nào</h4>
                    <p>Vui lòng th? l?i v?i tiêu chí tìm ki?m khác</p>
                    <a href="@Url.Action("Index", "Xe")" class="btn btn-primary">
                        <i class="fas fa-redo"></i> Xem t?t c? xe
                    </a>
                </div>
            </div>
        }
    </div>
</div>
